// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH (managed by Auth.js via @auth/prisma-adapter)
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// CORE USER MODEL
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  TEAM_MEMBER
  CLIENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String?
  avatarUrl    String?
  role         UserRole @default(CLIENT)
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // CRM relations
  sentInvitations     Invitation[]  @relation("InvitedBy")
  receivedInvitation  Invitation?   @relation("InvitedUser")
  createdOrders       Order[]       @relation("OrderCreatedBy")
  clientOrders        Order[]       @relation("ClientOrders")
  clientInvoices      Invoice[]
  threadMemberships   ThreadMember[]
  sentMessages        Message[]
  notifications       Notification[]
  clientThread        Thread?

  @@map("users")
}

// ─────────────────────────────────────────────
// INVITATIONS
// ─────────────────────────────────────────────

model Invitation {
  id         String    @id @default(cuid())
  email      String
  role       UserRole
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  invitedById String
  invitedBy   User   @relation("InvitedBy", fields: [invitedById], references: [id])

  // Set after the user accepts and their account is created
  userId String? @unique
  user   User?   @relation("InvitedUser", fields: [userId], references: [id])

  @@map("invitations")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

enum OrderStatus {
  AWAITING_QUOTE
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  serviceTitle String
  description  String
  startDate    DateTime
  endDate      DateTime
  amount       Decimal?    @db.Decimal(10, 2) // null until SA quotes
  status       OrderStatus @default(AWAITING_QUOTE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  clientId  String
  client    User   @relation("ClientOrders", fields: [clientId], references: [id])

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  invoices Invoice[]

  @@map("orders")
}

// ─────────────────────────────────────────────
// INVOICES
// ─────────────────────────────────────────────

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique // INV-0001
  dueDate       DateTime
  isPaid        Boolean   @default(false)
  paidAt        DateTime?
  notes         String?
  isLocked      Boolean   @default(false) // true when order → COMPLETED or CANCELLED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderId  String
  order    Order  @relation(fields: [orderId], references: [id])

  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  lineItems InvoiceLineItem[]

  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 2)
  rate        Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2) // quantity * rate (computed + stored)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

// Global invoice counter (single row)
model InvoiceCounter {
  id      Int @id @default(1)
  lastNum Int @default(0)

  @@map("invoice_counter")
}

// ─────────────────────────────────────────────
// MESSAGING THREADS
// ─────────────────────────────────────────────

model Thread {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // One thread per client
  clientId String @unique
  client   User   @relation(fields: [clientId], references: [id])

  members  ThreadMember[]
  messages Message[]

  @@map("threads")
}

model ThreadMember {
  id         String   @id @default(cuid())
  assignedAt DateTime @default(now())

  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([threadId, userId])
  @@map("thread_members")
}

enum MessageType {
  USER       // Regular user message
  SYSTEM     // Auto-posted (order update, invoice created)
}

model Message {
  id        String      @id @default(cuid())
  body      String
  type      MessageType @default(USER)
  metadata  Json?       // { orderId?, invoiceId?, event? } for system messages
  createdAt DateTime    @default(now())

  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String?
  sender   User?   @relation(fields: [senderId], references: [id])

  attachments Attachment[]

  @@map("messages")
}

model Attachment {
  id                 String   @id @default(cuid())
  fileName           String
  fileSize           Int      // bytes
  cloudinaryPublicId String
  cloudinaryUrl      String
  createdAt          DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

enum NotificationType {
  NEW_MESSAGE
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  INVOICE_CREATED
  INVOICE_PAID
  INVITATION_SENT
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  link      String? // deep link within the portal
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
