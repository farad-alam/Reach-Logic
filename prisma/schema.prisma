// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH (managed by Auth.js via @auth/prisma-adapter)
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// CORE USER MODEL
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  TEAM_MEMBER
  CLIENT
  CLIENT_COLLEAGUE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  fullName     String?
  company      String?
  phone        String?
  address      String?
  state        String?
  country      String?
  timezone     String?
  avatarUrl    String?
  designation  String?
  role         UserRole  @default(CLIENT)
  passwordHash String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // CRM relations
  sentInvitations    Invitation[]      @relation("InvitedBy")
  receivedInvitation Invitation?       @relation("InvitedUser")
  createdOrders      Order[]           @relation("OrderCreatedBy")
  clientOrders       Order[]           @relation("ClientOrders")
  clientInvoices     Invoice[]
  threadMemberships  ThreadMember[]
  sentMessages       Message[]
  notifications      Notification[]
  clientThreads      Thread[]
  clientColleagues   ClientColleague[] @relation("ClientColleagues")
  colleagueOf        ClientColleague[] @relation("ColleagueOf")

  @@map("users")
}

// ─────────────────────────────────────────────
// CLIENT COLLEAGUES
// ─────────────────────────────────────────────

model ClientColleague {
  id          String   @id @default(cuid())
  clientId    String // The original client who invited
  client      User     @relation("ClientColleagues", fields: [clientId], references: [id])
  colleagueId String // The colleague user
  colleague   User     @relation("ColleagueOf", fields: [colleagueId], references: [id])
  threadId    String // The specific thread they were added to
  thread      Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  status      String   @default("INVITED") // "INVITED" | "ACTIVE"
  invitedAt   DateTime @default(now())

  @@unique([clientId, colleagueId, threadId])
  @@map("client_colleagues")
}

// ─────────────────────────────────────────────
// INVITATIONS
// ─────────────────────────────────────────────

model Invitation {
  id         String    @id @default(cuid())
  email      String
  role       UserRole
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  invitedById String
  invitedBy   User   @relation("InvitedBy", fields: [invitedById], references: [id])

  // Set after the user accepts and their account is created
  userId String? @unique
  user   User?   @relation("InvitedUser", fields: [userId], references: [id])

  @@map("invitations")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

enum OrderStatus {
  AWAITING_QUOTE
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  serviceTitle String
  description  String
  startDate    DateTime
  endDate      DateTime
  amount       Decimal?    @db.Decimal(10, 2) // null until SA quotes
  status       OrderStatus @default(AWAITING_QUOTE)

  // Billing address captured at project creation
  billingStreet  String?
  billingCity    String?
  billingState   String?
  billingZip     String?
  billingCountry String?

  currency         String  @default("USD")
  isOffPortal      Boolean @default(false)
  offPortalName    String?
  offPortalEmail   String?
  offPortalCompany String?
  offPortalAddress String?
  offPortalCountry String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  clientId String?
  client   User?   @relation("ClientOrders", fields: [clientId], references: [id])

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  // Optional thread link — set when order is created from a specific thread
  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  invoices Invoice[]

  @@map("orders")
}

// ─────────────────────────────────────────────
// INVOICES
// ─────────────────────────────────────────────

enum InvoiceStatus {
  ACTIVE
  VOID
  SYSTEM_GLITCH
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundType {
  FULL
  PARTIAL
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique // INV-0001
  dueDate       DateTime
  isPaid        Boolean   @default(false)
  paidAt        DateTime?
  amountPaid    Decimal   @default(0) @db.Decimal(10, 2) // Tracks partial payments
  notes         String?
  isLocked      Boolean   @default(false) // true when order → COMPLETED or CANCELLED
  deletedAt     DateTime?
  
  // Refund, Void, System Glitch fields
  invoiceStatus InvoiceStatus @default(ACTIVE)
  refundType    RefundType?
  refundAmount  Decimal?      @db.Decimal(10, 2)
  refundDate    DateTime?
  refundMethod  String?
  voidDate      DateTime?
  glitchDate    DateTime?
  actionReason  String?
  actionDate    DateTime?
  actionBy      String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  clientId String?
  client   User?   @relation(fields: [clientId], references: [id])

  // Billing address (snapshot at invoice time)
  billingName    String?
  billingEmail   String?
  billingCompany String?
  billingAddress String?
  billingCountry String?
  currency       String  @default("USD")

  lineItems InvoiceLineItem[]
  auditLogs InvoiceAuditLog[]
  payments  InvoicePayment[]

  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 2)
  rate        Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2) // quantity * rate (computed + stored)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

// Global invoice counter (single row)
model InvoiceCounter {
  id      Int @id @default(1)
  lastNum Int @default(0)

  @@map("invoice_counter")
}

model InvoicePayment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2) // negative for refund rows
  currency  String   @default("USD")
  method    String?
  paidAt    DateTime @default(now())
  notes     String?
  isRefund  Boolean  @default(false)
  refundFor String?  // id of the original InvoicePayment this reverses
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([paidAt])
  @@map("invoice_payments")
}

model InvoiceAuditLog {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action      String   
  performedBy String   
  performedAt DateTime @default(now())
  metadata    Json?    

  @@map("invoice_audit_logs")
}

// ─────────────────────────────────────────────
// MESSAGING THREADS
// ─────────────────────────────────────────────

model Thread {
  id        String   @id @default(cuid())
  name      String   @default("General") // Display name, max 30 chars
  createdAt DateTime @default(now())

  // Many threads per client (removed @unique)
  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  members    ThreadMember[]
  messages   Message[]
  orders     Order[]
  colleagues ClientColleague[]

  @@index([clientId])
  @@map("threads")
}

model ThreadMember {
  id         String   @id @default(cuid())
  assignedAt DateTime @default(now())

  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([threadId, userId])
  @@map("thread_members")
}

enum MessageType {
  USER // Regular user message
  SYSTEM // Auto-posted (order update, invoice created)
}

model Message {
  id        String      @id @default(cuid())
  body      String
  type      MessageType @default(USER)
  metadata  Json? // { orderId?, invoiceId?, event? } for system messages
  createdAt DateTime    @default(now())

  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderId String?
  sender   User?   @relation(fields: [senderId], references: [id])

  attachments Attachment[]

  @@map("messages")
}

model Attachment {
  id                 String   @id @default(cuid())
  fileName           String
  fileSize           Int // bytes
  cloudinaryPublicId String
  cloudinaryUrl      String
  createdAt          DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

enum NotificationType {
  NEW_MESSAGE
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  INVOICE_CREATED
  INVOICE_PAID
  INVITATION_SENT
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  link      String? // deep link within the portal
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
